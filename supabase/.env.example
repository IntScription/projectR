# Copy to supabase/.env (gitignored) and fill in. Referenced from
# config.toml via env(...) — only for secrets that actually need to stay
# secret (GitHub's OAuth flow does a real server-side code exchange, unlike
# Apple/Google's native ID-token flows, which don't need this).
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# Any random value works locally — this only proves a send-push request
# came from our own trigger. Generate your own for a real deployment:
# `openssl rand -hex 32`.
PUSH_WEBHOOK_SECRET=

# Same idea, for capture-repo-snapshots: `openssl rand -hex 32`.
REPO_SNAPSHOT_WEBHOOK_SECRET=

# Real Anthropic API key for generate-project-bio's fallback tier (used
# when a device can't run Apple's on-device FoundationModels). Get one at
# https://console.anthropic.com. Without it, that function returns a
# clear 503 rather than a confusing failure — the on-device tier still
# works regardless.
ANTHROPIC_API_KEY=

# Real push delivery needs these from a paid Apple Developer account:
# APNS_KEY_ID / APNS_TEAM_ID from an APNs Auth Key you create at
# developer.apple.com > Certificates, Identifiers & Profiles > Keys, and
# APNS_PRIVATE_KEY is the full contents of the downloaded .p8 file. Until
# these are set, push sending no-ops (in-app notifications still work).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.mrk.projectr
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox
